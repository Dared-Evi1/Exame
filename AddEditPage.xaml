<Page x:Class="Test.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Test"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>

            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0" Height="30" Grid.Column="0">
            <TextBlock Text="Артикул" Margin="5" Width="110"></TextBlock>
            <TextBox Text="{Binding Articul}" Width="175" ></TextBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="1" Height="30" Grid.Column="0">
            <TextBlock Text="Название" Margin="5" Width="110"></TextBlock>
            <TextBox Text="{Binding Name_Product}" Width="175"></TextBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="2" Height="30" Grid.Column="0">
            <TextBlock Text="Категория" Margin="5" Width="110"></TextBlock>
            <ComboBox Name="CategoryComboBox" SelectedValue="{Binding ID_Category}" DisplayMemberPath="Name_Category" SelectedValuePath="ID_Category" Width="175">
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="3" Height="30" Grid.Column="0">
            <TextBlock Text="Описание" Margin="5" Width="110"></TextBlock>
            <TextBox Text="{Binding Description}" Width="175"></TextBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="4" Height="30" Grid.Column="0">
            <TextBlock Text="Производтель" Margin="5" Width="110"></TextBlock>
            <ComboBox Name="ManufacturerComboBox" SelectedValue="{Binding ID_Manufacturer}" DisplayMemberPath="Name_Manufacturer}" SelectedValuePath="ID_Manufacturer" Width="175">
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="5" Height="30" Grid.Column="0">
            <TextBlock Text="Поставщик" Margin="5" Width="110"></TextBlock>
            <ComboBox Name="ImporterComboBox" SelectedValue="{Binding ID_Importer}" DisplayMemberPath="Name_Importer" SelectedValuePath="ID_Importer" Width="175">
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="6" Height="30" Grid.Column="0">
            <TextBlock Text="Цена" Margin="5" Width="110"></TextBlock>
            <TextBox Text="{Binding Cost}" Width="175"></TextBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="7" Height="30" Grid.Column="0">
            <TextBlock Text="Единица измерения" Margin="5" Width="110"></TextBlock>
            <TextBox Text="{Binding Unit}" Width="175"></TextBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="8" Height="30" Grid.Column="0">
            <TextBlock Text="Количество" Margin="5" Width="110"></TextBlock>
            <TextBox Text="{Binding Quantity}" Name="Quan" Width="175"></TextBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="9" Height="30" Grid.Column="0">
            <TextBlock Text="Скидка" Margin="5" Width="110"></TextBlock>
            <TextBox Text="{Binding Discount}" Width="175"></TextBox>
        </StackPanel>
        <Button Name="Save" Click="Save_Click" Content="Сохранить" Grid.Row="10"></Button>
        <Image Grid.Column="1" Grid.RowSpan="8" Name="ImageProduct" Width="300" Stretch="Uniform">
            <Image.Source>
                <Binding Path="ProductPhoto">
                    <Binding.TargetNullValue>
                        <ImageSource>/Res/picture.png</ImageSource>
                    </Binding.TargetNullValue>
                </Binding>
            </Image.Source>
        </Image>
        <Button Name="ChangePicture" Click="ChangePicture_Click" Content="Изменить" Grid.Row="8" Grid.Column="1"></Button>
    </Grid></Page>
