<Page x:Class="Test.productPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Test"
      mc:Ignorable="d" Loaded="Page_Loaded"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="productPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Name="StackPoisk" Margin="5">
            <TextBlock Text="Поиск"/>
            <TextBox Name="PoiskTextBox" TextChanged="PoiskTextBox_TextChanged"/>
        </StackPanel>
        <StackPanel  Grid.Row="0" Grid.Column="1" Name="StackFiltr" Margin="5">
            <TextBlock Text="Фильтрация"/>
            <ComboBox Name="FiltrCombobox" SelectionChanged="FiltrCombobox_SelectionChanged">
                <TextBlock>все скидки</TextBlock>
                <TextBlock>0-11,99%</TextBlock>
                <TextBlock>12-18,99%</TextBlock>
                <TextBlock>19% и более</TextBlock>

            </ComboBox>
        </StackPanel>
        <StackPanel  Grid.Row="0" Grid.Column="2" Name="StackSort" Margin="5">
            <TextBlock Text="Сортировка"/>
            <ComboBox Name="SortCombobox" SelectionChanged="SortCombobox_SelectionChanged">
                <TextBlock>без сортировка</TextBlock>
                <TextBlock>возрастанию на складе</TextBlock>
                <TextBlock>убыванию на складе</TextBlock>
                <TextBlock>возрастанию цены</TextBlock>
                <TextBlock>убыванию цены </TextBlock>
                <TextBlock>возрастанию скидки</TextBlock>
                <TextBlock>убыванию скидки</TextBlock>
            </ComboBox>
        </StackPanel>
        <Button Name="AddProduct" Content="dobavit" Grid.Row="0" Grid.Column="3" Click="AddProduct_Click"/>
        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="4" Name="NameRole">
            <TextBlock Name="FIO"/>
            <TextBlock Name="Role"/>
        </StackPanel>
        <ListView Name="ProductListView" Grid.Row="1" Grid.ColumnSpan="5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{Binding backGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>

                        </Grid.RowDefinitions>
                        <Image  Grid.Column="0" Grid.RowSpan="6">
                            <Image.Source>
                                <Binding Path="ProductPhoto">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Res/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding CategoryPlusName}" Grid.Column="1" Grid.Row="0"/>
                        <TextBlock Text="{Binding Description, StringFormat=Описание {0}}" Grid.Column="1" Grid.Row="1"/>
                        <TextBlock Text="{Binding ManufacturerProduct, StringFormat=Производитель {0}}" Grid.Column="1" Grid.Row="2"/>
                        <TextBlock Text="{Binding ImporterProduct, StringFormat=Поставщик {0}}" Grid.Column="1" Grid.Row="3"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="4">
                            <TextBlock Text="Цена: "/>
                            <TextBlock Text="{Binding OldCost}" TextDecorations="Strikethrough"/>
                            <TextBlock Text="{Binding NewCost}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Unit, StringFormat=Единица измерения {0}}" Grid.Column="1" Grid.Row="5"/>
                        <TextBlock Text="{Binding Quantity,StringFormat= Количество на складе {0} }" Grid.Column="1" Grid.Row="6"/>

                        <StackPanel Orientation="Vertical" Grid.Column="2">
                            <TextBlock Text="{Binding DiscountPercent}"/>
                            <Button Name="Edit" Content="Edit" Click="Edit_Click"></Button>
                            <Button Name="Delete" Content="Delete" Click="Delete_Click"></Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
